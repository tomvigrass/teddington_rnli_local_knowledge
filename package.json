{
  "name": "local-knowledge-exam",
  "version": "1.0.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "optimize-images": "npx tsx scripts/optimizeImages.ts",
    "generate-image-map": "npx tsx scripts/generateImageMap.ts",
    "generate-questions": "npx tsx scripts/generateQuestions.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.3.28",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-haptics": "^15.0.8",
    "expo-image": "^3.0.11",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "jest": "^30.2.0",
    "jest-expo": "^54.0.17",
    "sharp": "^0.34.5",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(webp|jpg|jpeg|png)$": "<rootDir>/__tests__/__mocks__/fileMock.js",
      "^expo-image$": "<rootDir>/__tests__/__mocks__/expo-image.js"
    }
  },
  "private": true
}
